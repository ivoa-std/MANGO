  <uml:Model xmi:id="_HVneYHNnEfCqXtCgnWuTWw" name="mango">
    <eAnnotations xmi:id="_HVosgHNnEfCqXtCgnWuTWw" source="Objing">
      <contents xmi:type="uml:Property" xmi:id="_HVosgXNnEfCqXtCgnWuTWw" name="exporterVersion">
        <defaultValue xmi:type="uml:LiteralString" xmi:id="_HVosgnNnEfCqXtCgnWuTWw" value="3.0.0"/>
      </contents>
    </eAnnotations>
    <ownedComment xmi:type="uml:Comment" xmi:id="_HVosg3NnEfCqXtCgnWuTWw">
      <body>The purpose of MANGO, which stands for MO-del for AN-notating G-eneric O-objects, is to add an upper level of description to the tabular data of query responses. It allows metadata to be extended, complex quantities to be reconstructed from column values, and properties to be linked. It also allows to specify the origin af the data.
</body>
    </ownedComment>
    <ownedRule xmi:type="uml:Constraint" xmi:id="_HVoshHNnEfCqXtCgnWuTWw" constrainedElement="_HVrIynNnEfCqXtCgnWuTWw">
      <specification xmi:type="uml:LiteralString" xmi:id="_HVoshXNnEfCqXtCgnWuTWw" value="One association at the time&#10;"/>
    </ownedRule>
