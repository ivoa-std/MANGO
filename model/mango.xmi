          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GsWSmkLNEfCqUtlg_2M_9A" name="semiMinorAxis" visibility="public" type="_GsT2XkLNEfCqUtlg_2M_9A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_GsWSm0LNEfCqUtlg_2M_9A">
            <body>Half of the ellipse minor axis.</body>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GsWSnELNEfCqUtlg_2M_9A" name="angle" visibility="public" type="_GsT2XkLNEfCqUtlg_2M_9A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_GsWSnULNEfCqUtlg_2M_9A">
            <body>Angle between the North Polar Cape (NCP) and the major axis. This angle must be positive taking into account that angles are positive from North to the East. The angle has its own unit.</body>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_GsWSnkLNEfCqUtlg_2M_9A" name="PErrorSym2D">
