            <body>Error amplitude.</body>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_apKgCycmEfCmi6S6HBBkKg" name="PErrorEllipse">
        <ownedComment xmi:type="uml:Comment" xmi:id="_apKgDCcmEfCmi6S6HBBkKg">
          <body>Elliptical errror for 2D parameters such as the sky positions.</body>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="_apKgDScmEfCmi6S6HBBkKg" general="_apKgAScmEfCmi6S6HBBkKg"/>
