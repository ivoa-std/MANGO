        <ownedAttribute xmi:type="uml:Property" xmi:id="_GbTfKBemEfGw8eG7lhhRwg" name="semiMinorAxis" visibility="public" type="_GbRC1hemEfGw8eG7lhhRwg" isUnique="false">
