            <body>Confidence level of the error, expressed in \sigma.</body>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_xMHGBBxFEfCwBIIqXn3M7A" name="distribution" visibility="public" type="_xMDbohxFEfCwBIIqXn3M7A" isUnique="false"/>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_xMHGBRxFEfCwBIIqXn3M7A" name="PErrorSym1D">
