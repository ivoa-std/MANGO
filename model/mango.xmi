            <body>Error amplitude.</body>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_xMHGChxFEfCwBIIqXn3M7A" name="PErrorEllipse">
        <ownedComment xmi:type="uml:Comment" xmi:id="_xMHGCxxFEfCwBIIqXn3M7A">
          <body>Elliptical errror for 2D parameters such as the sky positions.</body>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="_xMHGDBxFEfCwBIIqXn3M7A" general="_xMHGABxFEfCwBIIqXn3M7A"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_xMHGDRxFEfCwBIIqXn3M7A" name="semiMajorAxis" visibility="public" type="_xMDbsRxFEfCwBIIqXn3M7A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_xMHGDhxFEfCwBIIqXn3M7A">
