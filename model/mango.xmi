          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_GbTfIxemEfGw8eG7lhhRwg" name="PErrorEllipse">
        <ownedComment xmi:type="uml:Comment" xmi:id="_GbTfJBemEfGw8eG7lhhRwg">
          <body>Elliptical errror for 2D parameters such as the sky positions.</body>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="_GbTfJRemEfGw8eG7lhhRwg" general="_GbTfGRemEfGw8eG7lhhRwg"/>
