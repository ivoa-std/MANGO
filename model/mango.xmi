  <uml:Model xmi:id="_Bqy-0Bn9EfCYEYvDHNN4tQ" name="mango">
    <eAnnotations xmi:id="_Bq0M8Bn9EfCYEYvDHNN4tQ" source="Objing">
      <contents xmi:type="uml:Property" xmi:id="_Bq0M8Rn9EfCYEYvDHNN4tQ" name="exporterVersion">
        <defaultValue xmi:type="uml:LiteralString" xmi:id="_Bq0M8hn9EfCYEYvDHNN4tQ" value="3.0.0"/>
      </contents>
    </eAnnotations>
    <ownedComment xmi:type="uml:Comment" xmi:id="_Bq0M8xn9EfCYEYvDHNN4tQ">
      <body>The purpose of MANGO, which stands for MO-del for AN-notating G-eneric O-objects, is to add an upper level of description to the tabular data of query responses. It allows metadata to be extended, complex quantities to be reconstructed from column values, and properties to be linked. It also allows to specify the origin af the data.
</body>
    </ownedComment>
    <ownedRule xmi:type="uml:Constraint" xmi:id="_Bq0M9Bn9EfCYEYvDHNN4tQ" constrainedElement="_Bq2pMBn9EfCYEYvDHNN4tQ">
      <specification xmi:type="uml:LiteralString" xmi:id="_Bq0M9Rn9EfCYEYvDHNN4tQ" value="One association at the time&#10;"/>
    </ownedRule>
