          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_xMHGERxFEfCwBIIqXn3M7A" name="angle" visibility="public" type="_xMDbsRxFEfCwBIIqXn3M7A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_xMHGEhxFEfCwBIIqXn3M7A">
            <body>Angle between the North Polar Cape (NCP) and the major axis. This angle must be positive taking into account that angles are positive from North to the East. The angle has its own unit.</body>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
