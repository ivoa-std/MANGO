      <packagedElement xmi:type="uml:DataType" xmi:id="_GsVrtELNEfCqUtlg_2M_9A" name="PropertyError" isAbstract="true">
        <ownedComment xmi:type="uml:Comment" xmi:id="_GsVrtULNEfCqUtlg_2M_9A">
          <body>Root (abstract) class of the errors that can be attached to a MA?GO property. The class inherit from \texttt{meas:uncertainty} in order to be usable in the context of properties based on \texttt{Measures} classes.
</body>
        </ownedComment>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GsVrtkLNEfCqUtlg_2M_9A" name="confidenceLevel" visibility="public" type="_GsTPRkLNEfCqUtlg_2M_9A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_GsVrt0LNEfCqUtlg_2M_9A">
            <body>Confidence level of the error, expressed in \sigma.</body>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GsVruELNEfCqUtlg_2M_9A" name="distribution" visibility="public" type="_GsTPSkLNEfCqUtlg_2M_9A" isUnique="false"/>
      </packagedElement>
