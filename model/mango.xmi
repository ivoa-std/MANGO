        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_qFXr2DS6EfCAN971ij3nig"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="_qFXr2TS6EfCAN971ij3nig" name="identifier" visibility="public" type="_qFWdsjS6EfCAN971ij3nig" isUnique="false">
        <ownedComment xmi:type="uml:Comment" xmi:id="_qFXr2jS6EfCAN971ij3nig">
          <body>Unique identifier for a Source.
The uniqueness of that identifier is not managed by the model.
The format is free.</body>
        </ownedComment>
