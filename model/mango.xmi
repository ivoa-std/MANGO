        <ownedAttribute xmi:type="uml:Property" xmi:id="_xMHGDxxFEfCwBIIqXn3M7A" name="semiMinorAxis" visibility="public" type="_xMDbsRxFEfCwBIIqXn3M7A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_xMHGEBxFEfCwBIIqXn3M7A">
