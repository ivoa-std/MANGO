        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="_TIhMahBZEfCuh7ipan5nEA"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="_TIhMaxBZEfCuh7ipan5nEA" name="identifier" visibility="public" type="_TIf-RRBZEfCuh7ipan5nEA" isUnique="false">
        <ownedComment xmi:type="uml:Comment" xmi:id="_TIhMbBBZEfCuh7ipan5nEA">
          <body>Unique identifier for a Source.
The uniqueness of that identifier is not managed by the model.
The format is free.</body>
        </ownedComment>
      </ownedAttribute>
