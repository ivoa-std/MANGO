  <uml:Model xmi:id="_tWnPoO-ZEe-dKr46c6-KEg" name="mango">
    <eAnnotations xmi:id="_tWn2sO-ZEe-dKr46c6-KEg" source="Objing">
      <contents xmi:type="uml:Property" xmi:id="_tWodwO-ZEe-dKr46c6-KEg" name="exporterVersion">
        <defaultValue xmi:type="uml:LiteralString" xmi:id="_tWodwe-ZEe-dKr46c6-KEg" value="3.0.0"/>
      </contents>
    </eAnnotations>
    <ownedComment xmi:type="uml:Comment" xmi:id="_tWodwu-ZEe-dKr46c6-KEg">
      <body>The purpose of MANGO, which stands for MO-del for AN-notating G-eneric O-objects, is to add an upper level of description to the tabular data of query responses. It allows metadata to be extended, complex quantities to be reconstructed from column values, and properties to be linked. It also allows to specify the origin af the data.
</body>
    </ownedComment>
    <ownedRule xmi:type="uml:Constraint" xmi:id="_tWodw--ZEe-dKr46c6-KEg" constrainedElement="_tWrhHO-ZEe-dKr46c6-KEg">
      <specification xmi:type="uml:LiteralString" xmi:id="_tWodxO-ZEe-dKr46c6-KEg" value="One association at the time&#10;"/>
    </ownedRule>
