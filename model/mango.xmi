      <ownedAttribute xmi:type="uml:Property" xmi:id="_HbruOdaQEfCO74PxqzgRoA" name="identifier" visibility="public" type="_Hbp5CNaQEfCO74PxqzgRoA" isUnique="false">
        <ownedComment xmi:type="uml:Comment" xmi:id="_HbruOtaQEfCO74PxqzgRoA">
          <body>Unique identifier for a Source.
