          <ownedComment xmi:type="uml:Comment" xmi:id="_GsWSlELNEfCqUtlg_2M_9A">
            <body>Error amplitude.</body>
          </ownedComment>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="_GsWSlULNEfCqUtlg_2M_9A" name="PErrorEllipse">
        <ownedComment xmi:type="uml:Comment" xmi:id="_GsWSlkLNEfCqUtlg_2M_9A">
          <body>Elliptical errror for 2D parameters such as the sky positions.</body>
        </ownedComment>
        <generalization xmi:type="uml:Generalization" xmi:id="_GsWSl0LNEfCqUtlg_2M_9A" general="_GsVrtELNEfCqUtlg_2M_9A"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="_GsWSmELNEfCqUtlg_2M_9A" name="semiMajorAxis" visibility="public" type="_GsT2XkLNEfCqUtlg_2M_9A" isUnique="false">
          <ownedComment xmi:type="uml:Comment" xmi:id="_GsWSmULNEfCqUtlg_2M_9A">
