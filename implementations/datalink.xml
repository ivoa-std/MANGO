      <FIELD name="s_dec" datatype="double" ucd="pos.eq.dec" unit="deg"
        utype="obscore:Char.SpatialAxis.Coverage.Location.Coord.Position2D.Value2.C2">
        <DESCRIPTION>DEC of central coordinates</DESCRIPTION>
